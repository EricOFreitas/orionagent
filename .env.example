# Telegram Bot Token — obtain from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Anthropic API Key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your personal Telegram Chat ID — obtain from @userinfobot
USER_CHAT_ID=123456789

# Timezone used for scheduled jobs (IANA format)
# Examples: America/Sao_Paulo, America/New_York, Europe/Lisbon
TIMEZONE=America/Sao_Paulo

# Horário do planejamento noturno (HH:MM, 24h) — feito na véspera antes de dormir
PLANNING_TIME=23:30

# Dia da revisão semanal: sunday ou monday
WEEKLY_REVIEW_DAY=sunday

# Path to the SQLite database file (created automatically)
DATABASE_PATH=data/orion.db
